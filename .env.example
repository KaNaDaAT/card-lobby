# Copy to .env.local (not committed) and fill in what you need. Everything here ends up in the
# built JavaScript, so anyone who opens the site can read it. That is fine for a TURN account
# meant for your friend group, not for anything secret.

# TURN servers help players on networks that block direct connections (some offices, mobile
# carriers). Comma-separated. One free account from a TURN provider is enough for a group.
VITE_TURN_URLS=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# Nostr relays used to find each other, comma-separated. Leave empty for Trystero's defaults.
VITE_NOSTR_RELAYS=
